# Backend API URL (Leave empty for local Vite proxy or set your Render backend URL)
# Local: http://localhost:3001
# Production (Render): https://your-backend-name.onrender.com
VITE_API_URL=

# Backend WebSocket URL (Leave empty for local Vite proxy or set your Render backend WebSocket URL)
# Local: ws://localhost:3001/ws
# Production (Render): wss://your-backend-name.onrender.com/ws
VITE_WS_URL=
